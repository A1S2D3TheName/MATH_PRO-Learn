{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A1S2D3TheName/MATH_PRO/math_repo_education/schemas/competency.schema.json",
  "title": "Измерение компетенции",
  "description": "Одно из пяти минимальных измерений учебной системы MATH_PRO. Измерение — это не навык, а способность, которую видно по конкретному протоколу. Протоколы описаны в specs/.",
  "type": "object",
  "required": ["id", "title", "definition", "observable_signal", "protocol", "confounders"],
  "properties": {
    "id": {
      "type": "string",
      "enum": ["immediate_mastery", "delayed_retention", "transfer", "error_diagnosis", "independence"]
    },
    "title": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1, "description": "Что именно измеряется, одной фразой."},
    "observable_signal": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Наблюдаемые признаки: по каким наблюдениям агент делает вывод."
    },
    "protocol": {
      "type": "object",
      "required": ["procedure", "instrumentation"],
      "properties": {
        "procedure": {"type": "string", "minLength": 1},
        "instrumentation": {"type": "array", "items": {"type": "string"}},
        "interval_days": {"type": "array", "items": {"type": "integer"}},
        "source_ids": {"type": "array", "items": {"type": "string"}, "description": "Источники-поставщики материала."}
      }
    },
    "confounders": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Что может исказить измерение и как это контролировать."
    },
    "not_measured_by": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Измерения, с которыми его нельзя смешивать в один показатель."
    }
  },
  "additionalProperties": true
}
